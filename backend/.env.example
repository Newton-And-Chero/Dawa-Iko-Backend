# --- App ---
ENV=local
LOG_LEVEL=INFO
# Externally reachable base URL for this deployment (used to build the CALL-E
# webhook_url). The api container can also reach itself at localhost:8000.
PUBLIC_BASE_URL=http://localhost:8000

# --- Database ---
# Service names (db/redis) resolve on the Docker Compose network the api
# container runs on. For host-side tools (e.g. a local alembic run, a DB
# GUI) use localhost:5433 for postgres and localhost:6379 for redis instead.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/calle

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Facility import (KMHFL) ---
# mock: reads data/seed/*.json. real: not implemented yet, see workflows/02.
FACILITY_IMPORT_MODE=mock
KMHFL_BASE_URL=https://api.kmhfl.health.go.ke
KMHFL_API_KEY=changeme

# --- CALL-E ---
# mock: no real phone calls are placed. live: real calls via the CALL-E API.
CALL_E_MODE=mock
CALLE_API_KEY=changeme
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_WEBHOOK_TOKEN=changeme
MAX_RECIPIENTS_PER_TASK=50

# --- SMS (Africa's Talking) ---
# mock: no real SMS is sent. live: real SMS via Africa's Talking.
SMS_MODE=mock
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=changeme
AFRICAS_TALKING_SENDER_ID=

# --- Auth ---
JWT_SECRET=changeme
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
