# --- App ---
ENV=local
LOG_LEVEL=INFO

# --- Database ---
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/calle

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- CALL-E ---
# mock: no real phone calls are placed. live: real calls via the CALL-E API.
CALL_E_MODE=mock
CALLE_API_KEY=changeme
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_WEBHOOK_TOKEN=changeme
MAX_RECIPIENTS_PER_TASK=50

# --- SMS (Africa's Talking) ---
# mock: no real SMS is sent. live: real SMS via Africa's Talking.
SMS_MODE=mock
AFRICAS_TALKING_USERNAME=sandbox
AFRICAS_TALKING_API_KEY=changeme
AFRICAS_TALKING_SENDER_ID=

# --- Auth ---
JWT_SECRET=changeme
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
