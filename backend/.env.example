# --- App ---
ENV=local
LOG_LEVEL=INFO
# Externally reachable base URL for this deployment (used to build the CALL-E
# webhook_url). The api container can also reach itself at localhost:8000.
PUBLIC_BASE_URL=http://localhost:8000

# --- Database ---
# Service names (db/redis) resolve on the Docker Compose network the api
# container runs on. For host-side tools (e.g. a local alembic run, a DB
# GUI) use localhost:5433 for postgres and localhost:6379 for redis instead.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/calle

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Facility import (KMHFL) ---
# mock: reads data/seed/*.json. real: not implemented yet, see workflows/02.
FACILITY_IMPORT_MODE=mock
KMHFL_BASE_URL=https://api.kmhfl.health.go.ke
KMHFL_API_KEY=changeme

# --- CALL-E ---
# mock: no real phone calls are placed. live: real calls via the CALL-E API.
CALL_E_MODE=mock
CALLE_API_KEY=changeme
CALLE_BASE_URL=https://api.heycall-e.com
CALLE_WEBHOOK_TOKEN=changeme
MAX_RECIPIENTS_PER_TASK=50

# Master switch fallback for the call engine. false = no outbound calls happen
# (sweeps still run and complete with zero calls) until an operator turns it on
# at runtime via POST /v1/call-engine/enable. The live on/off state is held in
# Redis; this only decides the value when that key was never set.
CALLS_ENABLED_DEFAULT=false

# --- CALL-E demo guardrail (hackathon) ---
# JSON array. When non-empty, every outbound call is redirected to one of these
# numbers (one per facility, by position) and a call task covers at most this
# many facilities — nothing else is ever dialed. Keep [] for normal operation.
# For a hackathon, set the real numbers in docker-compose.override.yml instead
# so they stay out of version control.
CALL_DEMO_REDIRECT_NUMBERS=[]

# --- SMS (Twilio) ---
# mock: no real SMS is sent. live: real SMS via Twilio.
SMS_MODE=mock
TWILIO_ACCOUNT_SID=changeme
TWILIO_AUTH_TOKEN=changeme
# Sender: a Twilio phone number in E.164, OR set TWILIO_MESSAGING_SERVICE_SID
# (starts with "MG...") which takes precedence. A trial account has one of each.
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# --- SMS demo guardrail (hackathon) ---
# JSON array. Mirrors CALL_DEMO_REDIRECT_NUMBERS for notifications: when
# non-empty, every outbound SMS is delivered to every number in this list
# instead of the real subscriber (a Twilio trial account can only text its own
# verified numbers). Keep [] for normal operation. For a hackathon, set the
# real numbers in docker-compose.override.yml instead so they stay out of
# version control.
SMS_DEMO_REDIRECT_NUMBERS=[]

# --- Email (subscriber notification_channel=email) ---
# mock: no real email is sent. live: real email via SMTP.
EMAIL_MODE=mock
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# --- Escalation & alerting ---
# A completed sweep at or below this in-stock fraction is scarce enough to
# run severity classification (0.5 = "half or fewer facilities in stock").
STOCKOUT_THRESHOLD_PCT=0.5

# --- Auth ---
JWT_SECRET=changeme
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Rate limiting (POST /v1/sweeps/query) ---
PUBLIC_QUERY_RATE_LIMIT=10
PUBLIC_QUERY_RATE_WINDOW_SECONDS=60

# --- CORS ---
# JSON array of allowed origins.
CORS_ALLOW_ORIGINS=["http://localhost:3000","http://localhost:5173"]
